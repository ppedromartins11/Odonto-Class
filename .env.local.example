# Copie este arquivo para .env.local e preencha com os valores do SEU
# projeto Supabase. NUNCA coloque valores reais neste arquivo
# (.env.local.example) nem faca commit de .env.local - ele ja esta no
# .gitignore.

# Painel do Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chave de servico - uso restrito a operacoes administrativas server-side.
# Nao deve ser usada no cliente nem exposta com prefixo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# URL publica do site, usada para montar o link de redefinicao de senha
# quando o cabecalho "origin" nao estiver disponivel (ex.: alguns
# ambientes de execucao de server actions). Em desenvolvimento:
# http://localhost:3000
NEXT_PUBLIC_SITE_URL=
