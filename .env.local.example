# Copie este arquivo para .env.local e preencha com os valores do SEU
# projeto Supabase. NUNCA coloque valores reais neste arquivo nem versione
# .env.local - ele ja esta no .gitignore.

# Painel do Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chave de servico: uso exclusivo no servidor para operacoes administrativas.
SUPABASE_SERVICE_ROLE_KEY=

# URL canonica do site, sem barra final. Exemplos:
# http://localhost:3000
# https://seu-dominio.example
NEXT_PUBLIC_SITE_URL=

# Segredo aleatorio com no minimo 32 caracteres para assinar o contexto
# temporario de convite/recuperacao. Nunca use a service role key aqui.
AUTH_FLOW_COOKIE_SECRET=
