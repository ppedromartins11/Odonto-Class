# Copie para .env.test.local somente em uma homologacao isolada.
# O teste cria e remove usuarios ficticios; nunca aponte para producao.
SUPABASE_TEST_HOMOLOGATION=I_ACKNOWLEDGE_FAKE_DATA_ONLY
SUPABASE_TEST_URL=
SUPABASE_TEST_ANON_KEY=
SUPABASE_TEST_SERVICE_ROLE_KEY=

# URI Postgres da homologacao (percent-encoded) para aplicar/lintar migrations.
# Nao e usada pela aplicacao nem pelos testes funcionais.
SUPABASE_TEST_DB_URL=

# Administrador ativo ja existente na homologacao e reservado para testes.
SUPABASE_TEST_ADMIN_EMAIL=
SUPABASE_TEST_ADMIN_PASSWORD=
