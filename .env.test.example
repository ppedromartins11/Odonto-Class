# Copie para .env.test.local somente em uma homologacao isolada.
# O teste cria e remove usuarios ficticios; nunca aponte para producao.
SUPABASE_TEST_HOMOLOGATION=I_ACKNOWLEDGE_FAKE_DATA_ONLY
# Allowlist explicita: deve ser identica ao project ref vinculado pelo Supabase CLI.
SUPABASE_TEST_PROJECT_REF=
SUPABASE_TEST_URL=
SUPABASE_TEST_ANON_KEY=
SUPABASE_TEST_SERVICE_ROLE_KEY=

# URI Postgres da homologacao (percent-encoded) para aplicar/lintar migrations.
# A suite release-highs usa esta URI somente quando API e banco sao loopback.
SUPABASE_TEST_DB_URL=

# Administrador ativo reservado a QA; nome deve iniciar com QA_ ou HOMOLOG_.
# A suite cadastra/remove somente um fator TOTP temporario nessa conta QA.
SUPABASE_TEST_ADMIN_EMAIL=
SUPABASE_TEST_ADMIN_PASSWORD=

# Opcional: app local compilada com o MESMO Supabase local. H01 testa HTTP/binario.
SUPABASE_TEST_APP_URL=
