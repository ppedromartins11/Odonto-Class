# Copie para .env.homologacao.local (ignorado pelo Git) e preencha somente
# valores do projeto QA/Preview. Nunca use credenciais de Production.
SUPABASE_TEST_HOMOLOGATION=I_ACKNOWLEDGE_FAKE_DATA_ONLY
SUPABASE_TEST_URL=
SUPABASE_TEST_PROJECT_REF=
QA_SUPABASE_PROJECT_REF=
PRODUCTION_SUPABASE_PROJECT_REF=
DR_SUPABASE_PROJECT_REF=
# Valores de referência para coerência; confirme bindings Vercel por consulta administrativa independente.
VERCEL_PREVIEW_SUPABASE_PROJECT_REF=
VERCEL_PRODUCTION_SUPABASE_PROJECT_REF=
SUPABASE_TEST_ANON_KEY=
SUPABASE_TEST_DB_URL=
SUPABASE_TEST_SERVICE_ROLE_KEY=
# Opcional: comparado ao project ref QA se estiver definido.
NEXT_PUBLIC_SUPABASE_URL=

# URL HTTPS do Preview compatível com a migration 0030; necessária para H01-E.
HOMOLOGATION_BASE_URL=

# E-mails exatos podem ajudar a localizar fixtures já aceitas; não são exibidos.
HOMOLOGATION_ADMIN_EMAIL=
HOMOLOGATION_DENTIST_A_EMAIL=
HOMOLOGATION_DENTIST_B_EMAIL=
HOMOLOGATION_RECEPTION_EMAIL=

# Necessários somente para autenticação funcional. Aceite convites pelo fluxo
# normal antes de configurar. Senhas nunca são emitidas no relatório.
HOMOLOGATION_ADMIN_PASSWORD=
HOMOLOGATION_DENTIST_A_PASSWORD=
HOMOLOGATION_DENTIST_B_PASSWORD=
HOMOLOGATION_RECEPTION_PASSWORD=

SUPABASE_TEST_ENVIRONMENT=homologation
# Refer?ncias de Production proibidas, separadas por v?rgula.
SUPABASE_PRODUCTION_PROJECT_REFS=
